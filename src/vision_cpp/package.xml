<?xml version="1.0"?>
<package format="3">
  <name>vision_cpp</name>
  <version>0.1.0</version>
  <description>Bounded native CSI JPEG capture and QR processing for IJKbot.</description>
  <maintainer email="team@ijkbot.local">IJKbot Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>python3-opencv</test_depend>
  <test_depend>python3-numpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
